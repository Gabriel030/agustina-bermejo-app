{
  "name": "e2e",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:flows": "playwright test --grep @flow",
    "test:demo": "playwright test --config playwright.demo.config.js",
    "test:visual": "playwright test -c playwright.visual.config.js",
    "test:visual:update": "playwright test -c playwright.visual.config.js --update-snapshots"
  },
  "devDependencies": {
    "@playwright/test": "1.55.0"
  }
}
