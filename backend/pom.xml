<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.7</version>
		<relativePath/> <!-- lookup parent from repository -->
	</parent>
	<groupId>com.red-escuela</groupId>
	<artifactId>backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<name>backend</name>
	<description>Demo project for Spring Boot</description>
	<url/>
	<licenses>
		<license/>
	</licenses>
	<developers>
		<developer/>
	</developers>
	<scm>
		<connection/>
		<developerConnection/>
		<tag/>
		<url/>
	</scm>
	<properties>
		<java.version>21</java.version>
		<test.forkCount>2</test.forkCount>
		<argLine></argLine>
		<shedlock.version>6.10.0</shedlock.version>
		<jqwik.version>1.9.3</jqwik.version>
		<pitest.version>1.20.4</pitest.version>
		<pitest-junit5.version>1.2.3</pitest-junit5.version>
		<spring-modulith.version>1.4.13</spring-modulith.version>
	</properties>
	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>org.springframework.modulith</groupId>
				<artifactId>spring-modulith-bom</artifactId>
				<version>${spring-modulith.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>
	<dependencies>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-core</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.modulith</groupId>
					<artifactId>spring-modulith-moments</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-jdbc</artifactId>
			<exclusions>
				<exclusion>
					<groupId>org.springframework.modulith</groupId>
					<artifactId>spring-modulith-moments</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.springframework.modulith</groupId>
			<artifactId>spring-modulith-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-spring</artifactId>
			<version>${shedlock.version}</version>
		</dependency>
		<dependency>
			<groupId>net.javacrumbs.shedlock</groupId>
			<artifactId>shedlock-provider-jdbc-template</artifactId>
			<version>${shedlock.version}</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-actuator</artifactId>
		</dependency>
		<dependency>
			<groupId>io.micrometer</groupId>
			<artifactId>micrometer-registry-prometheus</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-data-jpa</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-security</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-web</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-validation</artifactId>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-mail</artifactId>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-api</artifactId>
			<version>0.12.6</version>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-impl</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>io.jsonwebtoken</groupId>
			<artifactId>jjwt-jackson</artifactId>
			<version>0.12.6</version>
			<scope>runtime</scope>
		</dependency>

		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-devtools</artifactId>
			<scope>runtime</scope>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.postgresql</groupId>
			<artifactId>postgresql</artifactId>
			<scope>runtime</scope>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-core</artifactId>
		</dependency>
		<dependency>
			<groupId>org.flywaydb</groupId>
			<artifactId>flyway-database-postgresql</artifactId>
		</dependency>
		<dependency>
			<groupId>org.projectlombok</groupId>
			<artifactId>lombok</artifactId>
			<optional>true</optional>
		</dependency>
		<dependency>
			<groupId>org.apache.pdfbox</groupId>
			<artifactId>pdfbox</artifactId>
			<version>3.0.3</version>
		</dependency>
		<dependency>
			<groupId>org.apache.poi</groupId>
			<artifactId>poi-ooxml</artifactId>
			<version>5.3.0</version>
		</dependency>
		<dependency>
			<groupId>com.bucket4j</groupId>
			<artifactId>bucket4j-core</artifactId>
			<version>8.10.1</version>
		</dependency>
		<dependency>
			<groupId>com.google.api-client</groupId>
			<artifactId>google-api-client</artifactId>
			<version>2.7.0</version>
		</dependency>
		<dependency>
			<groupId>com.mercadopago</groupId>
			<artifactId>sdk-java</artifactId>
			<version>2.1.28</version>
		</dependency>
		<dependency>
			<groupId>org.springframework.boot</groupId>
			<artifactId>spring-boot-starter-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.springframework.security</groupId>
			<artifactId>spring-security-test</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>org.testcontainers</groupId>
			<artifactId>postgresql</artifactId>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>com.tngtech.archunit</groupId>
			<artifactId>archunit</artifactId>
			<version>1.4.2</version>
			<scope>test</scope>
		</dependency>
		<dependency>
			<groupId>net.jqwik</groupId>
			<artifactId>jqwik</artifactId>
			<version>${jqwik.version}</version>
			<scope>test</scope>
		</dependency>
		<!--
			QA de contrato HTTP con criterios de aceptación legibles (ver
			docs/context/testing.md, "QA de contrato HTTP (Karate)") — a diferencia de
			los tests de MockMvc, estos corren contra el server HTTP real levantado por
			@SpringBootTest(webEnvironment = RANDOM_PORT), mismo Testcontainers que el
			resto de la suite, sin necesidad de un job de CI separado.
		-->
		<dependency>
			<groupId>com.intuit.karate</groupId>
			<artifactId>karate-junit5</artifactId>
			<version>1.4.1</version>
			<scope>test</scope>
		</dependency>
	</dependencies>

	<build>
		<plugins>
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-surefire-plugin</artifactId>
				<configuration>
					<forkCount>${test.forkCount}</forkCount>
					<reuseForks>true</reuseForks>
					<argLine>@{argLine} -XX:TieredStopAtLevel=1 -XX:+UseParallelGC -XX:ReservedCodeCacheSize=512m -Xshare:auto</argLine>
				</configuration>
			</plugin>
			<plugin>
				<groupId>org.springframework.boot</groupId>
				<artifactId>spring-boot-maven-plugin</artifactId>
			</plugin>
			<plugin>
				<!--
					Fuerza JDK 21 (java.version de arriba) para compilar, sin importar qué
					`java` resuelva el shell por default. Necesario porque Lombok 1.18.42
					falla en silencio (sin error, sin warning, no genera getters/setters)
					bajo JDK 23 en esta máquina — detectado al agregar el primer código que
					llamaba a un getter de Lombok desde otra clase (JwtService -> Person).
					Requiere un toolchain JDK 21 declarado en ~/.m2/toolchains.xml.
				-->
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-toolchains-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<goals>
							<goal>toolchain</goal>
						</goals>
					</execution>
				</executions>
				<configuration>
					<toolchains>
						<jdk>
							<version>21</version>
						</jdk>
					</toolchains>
				</configuration>
			</plugin>
		</plugins>
	</build>

	<profiles>
		<profile>
			<id>mutation</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.pitest</groupId>
						<artifactId>pitest-maven</artifactId>
						<version>${pitest.version}</version>
						<dependencies>
							<dependency>
								<groupId>org.pitest</groupId>
								<artifactId>pitest-junit5-plugin</artifactId>
								<version>${pitest-junit5.version}</version>
							</dependency>
						</dependencies>
						<configuration>
							<targetClasses>
								<param>com.red_escuela.backend.shared.domain.*</param>
								<param>com.red_escuela.backend.shared.domain.policy.*</param>
								<param>com.red_escuela.backend.billing.configuration.policy.*</param>
								<param>com.red_escuela.backend.billing.configuration.domain.*</param>
								<param>com.red_escuela.backend.billing.operation.*</param>
								<param>com.red_escuela.backend.billing.authorization.domain.*</param>
								<param>com.red_escuela.backend.shared.domain.statemachine.*</param>
								<param>com.red_escuela.backend.billing.invoice.domain.*</param>
								<param>com.red_escuela.backend.billing.account.domain.*</param>
								<param>com.red_escuela.backend.billing.account.policy.*</param>
								<param>com.red_escuela.backend.billing.note.domain.*</param>
								<param>com.red_escuela.backend.billing.note.policy.*</param>
								<param>com.red_escuela.backend.billing.invoice.policy.issuing.*</param>
								<param>com.red_escuela.backend.billing.invoice.operation.InvoiceDiscountCalculator</param>
								<param>com.red_escuela.backend.billing.planning.policy.*</param>
								<param>com.red_escuela.backend.billing.planning.domain.*</param>
								<param>com.red_escuela.backend.billing.planning.service.*</param>
								<param>com.red_escuela.backend.billing.collections.policy.*</param>
							</targetClasses>
							<targetTests>
								<param>com.red_escuela.backend.shared.domain.*</param>
								<param>com.red_escuela.backend.billing.configuration.policy.*</param>
								<param>com.red_escuela.backend.billing.configuration.domain.*</param>
								<param>com.red_escuela.backend.billing.configuration.domain.*</param>
								<param>com.red_escuela.backend.billing.operation.*</param>
								<param>com.red_escuela.backend.billing.authorization.domain.*</param>
								<param>com.red_escuela.backend.billing.invoice.domain.*</param>
								<param>com.red_escuela.backend.billing.account.domain.*</param>
								<param>com.red_escuela.backend.billing.account.policy.*</param>
								<param>com.red_escuela.backend.billing.note.domain.*</param>
								<param>com.red_escuela.backend.billing.note.policy.*</param>
								<param>com.red_escuela.backend.billing.invoice.policy.issuing.*</param>
								<param>com.red_escuela.backend.billing.invoice.operation.*</param>
								<param>com.red_escuela.backend.billing.planning.*</param>
								<param>com.red_escuela.backend.billing.collections.policy.*</param>
							</targetTests>
							<excludedGroups>
								<param>integration</param>
							</excludedGroups>
							<excludedMethods>
								<param>toString</param>
								<param>hashCode</param>
							</excludedMethods>
							<mutationThreshold>90</mutationThreshold>
							<coverageThreshold>0</coverageThreshold>
							<failWhenNoMutations>false</failWhenNoMutations>
							<threads>4</threads>
							<withHistory>true</withHistory>
							<historyInputFile>${project.build.directory}/pit-history/history.bin</historyInputFile>
							<historyOutputFile>${project.build.directory}/pit-history/history.bin</historyOutputFile>
							<outputFormats>
								<param>HTML</param>
								<param>XML</param>
							</outputFormats>
							<timestampedReports>false</timestampedReports>
						</configuration>
						<executions>
							<execution>
								<id>mutation-coverage</id>
								<phase>verify</phase>
								<goals>
									<goal>mutationCoverage</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
	</profiles>

</project>
