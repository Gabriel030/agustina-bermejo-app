<?xml version="1.0" encoding="UTF-8"?>
<!--
    Logging centralizado: un único appender de consola con patrón estructurado, aplicado a
    toda la app (antes corría con el pattern default de Spring Boot, sin ningún control
    explícito). Solo consola (12-factor: los logs van a stdout, no a un archivo del
    filesystem del contenedor) — coherente con que todavía no se definió el despliegue en
    Docker (Fase 5, pendiente).

    Épica 17 Fase 5: se suma un appender JSON (ECS) que reemplaza al de texto plano solo
    fuera de desarrollo. Leer JSON crudo en la terminal mientras se programa es un
    retroceso, así que el pattern legible se mantiene para el día a día. El encoder va
    declarado acá y no por la propiedad logging.structured.format.console porque esa
    autoconfiguración de Spring Boot no aplica cuando el proyecto trae su propio
    logback-spring.xml, que es el caso.
-->
<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Perfil "test": baja el ruido para no inundar la salida de mvn test, que ya es
         verbosa por Flyway/Hibernate/Testcontainers. -->
    <springProfile name="test">
        <root level="WARN">
            <appender-ref ref="CONSOLE" />
        </root>
        <logger name="com.red_escuela.backend" level="INFO" />
    </springProfile>

    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
            <format>ecs</format>
        </encoder>
    </appender>

    <springProfile name="prod">
        <root level="INFO">
            <appender-ref ref="JSON" />
        </root>
    </springProfile>

    <!-- Desarrollo: todo lo que no sea test ni prod. El "!test" de antes cubría los dos
         casos a la vez; sin esta distinción, en prod saldrían las dos salidas duplicadas. -->
    <springProfile name="!test &amp; !prod">
        <root level="INFO">
            <appender-ref ref="CONSOLE" />
        </root>
    </springProfile>

</configuration>
