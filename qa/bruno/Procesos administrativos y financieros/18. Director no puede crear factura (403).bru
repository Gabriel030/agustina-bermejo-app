meta {
  name: 18. Director no puede crear factura (403)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/students/{{studentId}}/invoices
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{directorAccessToken}}
}

body:json {
  {
    "concept": "Cuota Abril",
    "amount": 5000,
    "dueDate": "2026-12-31"
  }
}

tests {
  test("status 403 — matriz: Director es solo R, la escritura es de Administrativo", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
