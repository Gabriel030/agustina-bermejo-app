meta {
  name: 9. Aplicar promocion segmentada del 10 por ciento (201)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/promotions
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{directorAccessTokenPrecios}}
}

body:json {
  {
    "programId": {{programIdPrecios}},
    "tipo": "PORCENTAJE",
    "valor": 10,
    "vigenteDesde": "2020-01-01"
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
