meta {
  name: 8. Aplicar beca individual del 20 por ciento (201)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/students/{{studentIdPrecios}}/discounts
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{directorAccessTokenPrecios}}
}

body:json {
  {
    "tipo": "PORCENTAJE",
    "valor": 20,
    "vigenteDesde": "2020-01-01",
    "motivo": "Beca por mérito académico"
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
