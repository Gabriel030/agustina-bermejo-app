meta {
  name: 15. Aprobar el comprobante crea el pago real (200)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/payment-receipts/{{segundoReceiptIdPrecios}}/approve
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenPrecios}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status APPROVED", function () {
    expect(res.getBody().status).to.equal("APPROVED");
  });
}
