meta {
  name: 16. La factura queda PAID (200)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/students/{{studentIdPrecios}}/invoices
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenPrecios}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("la factura de matrícula está PAID", function () {
    const factura = res.getBody().find(f => f.id === bru.getVar("invoiceIdPrecios"));
    expect(factura.status).to.equal("PAID");
  });
}
