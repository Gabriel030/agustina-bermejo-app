meta {
  name: 11. Subir comprobante (201)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/invoices/{{invoiceIdPrecios}}/payment-receipts
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenPrecios}}
}

body:multipart-form {
  file: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("receiptIdPrecios", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("status PENDING_REVIEW", function () {
    expect(res.getBody().status).to.equal("PENDING_REVIEW");
  });
}
