meta {
  name: 3. Registrar alumno (setup, 201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("usernameAlumnoPrecios", "bruno.precios." + Date.now());
}

body:json {
  {
    "nombre": "QA",
    "apellido": "Precios",
    "email": "{{usernameAlumnoPrecios}}@example.com",
    "username": "{{usernameAlumnoPrecios}}",
    "password": "Test1234",
    "institutionId": {{institutionId}}
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("alumnoAccessTokenPrecios", res.getBody().accessToken);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
