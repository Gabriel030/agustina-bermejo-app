meta {
  name: 4. Resolver studentId (setup)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/students?onboardingStatus=CONFIRMADO
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenPrecios}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const alumnos = res.getBody();
    const propio = alumnos.find(function (a) { return a.username === bru.getVar("usernameAlumnoPrecios"); });
    if (propio) {
      bru.setVar("studentIdPrecios", propio.id);
    }
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("encontró el alumno recién registrado por username", function () {
    expect(bru.getVar("studentIdPrecios")).to.not.be.undefined;
  });
}
