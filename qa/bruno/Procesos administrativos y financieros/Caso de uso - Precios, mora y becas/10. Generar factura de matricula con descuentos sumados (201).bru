meta {
  name: 10. Generar factura de matricula con descuentos sumados (201)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/students/{{studentIdPrecios}}/invoices/from-fee-schedule
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenPrecios}}
}

body:json {
  {
    "programId": {{programIdPrecios}},
    "concept": "MATRICULA",
    "dueDate": "2026-12-31"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("invoiceIdPrecios", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("20% + 10% = 30% de descuento sobre 50000 -> 35000", function () {
    expect(res.getBody().amount).to.equal(35000);
  });
  test("el concepto menciona Matrícula", function () {
    expect(res.getBody().concept).to.include("Matrícula");
  });
}
