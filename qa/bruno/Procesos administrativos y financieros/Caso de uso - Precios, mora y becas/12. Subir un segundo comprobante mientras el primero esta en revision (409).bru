meta {
  name: 12. Subir un segundo comprobante mientras el primero esta en revision (409)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/invoices/{{invoiceIdPrecios}}/payment-receipts
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenPrecios}}
}

body:multipart-form {
  file: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

tests {
  test("status 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
