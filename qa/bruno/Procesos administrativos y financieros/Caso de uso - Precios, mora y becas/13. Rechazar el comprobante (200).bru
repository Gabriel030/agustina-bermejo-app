meta {
  name: 13. Rechazar el comprobante (200)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/payment-receipts/{{receiptIdPrecios}}/reject
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenPrecios}}
}

body:json {
  {
    "reason": "Comprobante ilegible"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status REJECTED con motivo", function () {
    expect(res.getBody().status).to.equal("REJECTED");
    expect(res.getBody().rejectionReason).to.equal("Comprobante ilegible");
  });
}
