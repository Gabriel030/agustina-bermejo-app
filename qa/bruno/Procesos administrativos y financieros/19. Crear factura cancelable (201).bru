meta {
  name: 19. Crear factura cancelable (201)
  type: http
  seq: 19
}

post {
  url: {{baseUrl}}/students/{{studentId}}/invoices
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "concept": "Cuota Abril",
    "amount": 5000,
    "dueDate": "2026-12-31"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("invoiceIdCancelable", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
