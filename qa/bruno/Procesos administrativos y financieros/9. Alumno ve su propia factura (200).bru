meta {
  name: 9. Alumno ve su propia factura (200)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/me/invoices
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ve exactamente la factura que le creó Administración — autoservicio", function () {
    expect(res.getBody()).to.be.an("array").with.lengthOf(1);
    expect(res.getBody()[0].id).to.equal(bru.getVar("invoiceId"));
  });
}
