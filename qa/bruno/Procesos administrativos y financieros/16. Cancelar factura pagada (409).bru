meta {
  name: 16. Cancelar factura pagada (409)
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/invoices/{{invoiceId}}/cancel
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("status 409 — una factura PAID ya no se puede cancelar", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
