meta {
  name: 14. Completar el pago (201)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/invoices/{{invoiceId}}/payments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "amount": 6000,
    "method": "TRANSFER"
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
