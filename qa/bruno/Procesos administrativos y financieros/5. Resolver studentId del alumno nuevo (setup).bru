meta {
  name: 5. Resolver studentId del alumno nuevo (setup)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/students?onboardingStatus=CONFIRMADO
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

script:post-response {
  if (res.getStatus() === 200) {
    const alumnos = res.getBody();
    const propio = alumnos.find(function (a) { return a.username === bru.getVar("usernameAlumnoFacturacion"); });
    if (propio) {
      bru.setVar("studentId", propio.id);
    }
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("encontró el alumno recién registrado por username", function () {
    expect(bru.getVar("studentId")).to.not.be.undefined;
  });
}

docs {
  `StudentResponse.username` (dto/StudentResponse.java) es lo que permite
  ubicar el `studentId` del alumno creado en el paso anterior sin acceso
  directo a la base — mismo criterio de "solo HTTP" que el resto de la
  colección Bruno.
}
