meta {
  name: 21. Director aprueba excepcion (200)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/director-approval-requests/{{exceptionId}}/approve
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{directorAccessToken}}
}

body:json {
  {
    "notas": "Aprobado, presentó certificado"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status pasa a APPROVED", function () {
    expect(res.getBody().status).to.equal("APPROVED");
  });
}
