meta {
  name: 15. Constancia materias aprobadas post-egreso (201)
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/me/approved-subjects-certificates
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

body:json {
  {
    "enrollmentId": {{programEnrollmentId}}
  }
}

tests {
  test("status 201 — sin exigir cursada activa, a diferencia de la constancia regular", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("devuelve la constancia vigente de la matriculacion", function () {
    expect(res.getBody().enrollmentId).to.equal(Number(bru.getVar("programEnrollmentId")));
    expect(res.getBody().code).to.be.a("string");
  });
}
