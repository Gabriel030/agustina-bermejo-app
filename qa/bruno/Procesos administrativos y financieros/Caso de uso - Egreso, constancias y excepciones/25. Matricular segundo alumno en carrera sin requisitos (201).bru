meta {
  name: 25. Matricular segundo alumno en carrera sin requisitos (201)
  type: http
  seq: 25
}

post {
  url: {{baseUrl}}/students/{{studentId2}}/program-enrollments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "programId": {{programSinRequisitosId}}
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("programEnrollmentId2", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
