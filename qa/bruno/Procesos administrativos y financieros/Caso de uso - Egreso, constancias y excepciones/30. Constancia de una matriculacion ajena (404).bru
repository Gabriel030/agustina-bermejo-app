meta {
  name: 30. Constancia de una matriculacion ajena (404)
  type: http
  seq: 30
}

get {
  url: {{baseUrl}}/me/program-enrollments/{{programEnrollmentId2}}/certificates/approved-subjects
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

tests {
  test("status 404 — no 403, mismo criterio que el resto de autoservicio (ProgramEnrollmentNotFoundException)", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
