meta {
  name: 15. Factura pasa a PAID (200)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/students/{{studentId}}/invoices
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("factura completamente pagada", function () {
    const factura = res.getBody().find(function (f) { return f.id === bru.getVar("invoiceId"); });
    expect(factura.status).to.equal("PAID");
  });
}
