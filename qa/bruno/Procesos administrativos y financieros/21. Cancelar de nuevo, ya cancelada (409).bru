meta {
  name: 21. Cancelar de nuevo, ya cancelada (409)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/invoices/{{invoiceIdCancelable}}/cancel
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("status 409 — no se puede cancelar dos veces", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
