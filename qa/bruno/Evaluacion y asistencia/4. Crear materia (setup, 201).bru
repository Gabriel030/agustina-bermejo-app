meta {
  name: 4. Crear materia (setup, 201)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/subjects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

script:pre-request {
  bru.setVar("nombreMateria", "Materia evaluacion " + Date.now());
}

body:json {
  {
    "name": "{{nombreMateria}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("subjectId", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
