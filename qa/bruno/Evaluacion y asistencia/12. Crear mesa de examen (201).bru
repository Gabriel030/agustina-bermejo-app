meta {
  name: 12. Crear mesa de examen (201)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/exam-boards
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "subjectId": {{subjectId}},
    "termId": {{termId}},
    "examDate": "2026-07-01T00:00:00"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("examBoardId", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("status inicial SCHEDULED", function () {
    expect(res.getBody().status).to.equal("SCHEDULED");
  });
}
