meta {
  name: 5. Crear carrera (setup, 201)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/programs
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

script:pre-request {
  bru.setVar("nombrePrograma", "Bruno QA - Carrera evaluacion " + Date.now());
}

body:json {
  {
    "name": "{{nombrePrograma}}",
    "totalYears": 1,
    "totalCreditsRequired": 0
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("programId", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
