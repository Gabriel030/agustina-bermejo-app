meta {
  name: 23. Bandeja de comprobantes no trae comprobante de la solicitud (200)
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/payment-receipts
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenDocAlta}}
}

docs {
  D-227: solicitar no genera comprobante ni factura; la matrícula se factura recién al aprobar.
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("no hay comprobantes del alumno", function () {
    const propios = res.getBody().filter(r => r.studentName === "QA DocumentosAlta");
    expect(propios).to.have.lengthOf(0);
  });
}
