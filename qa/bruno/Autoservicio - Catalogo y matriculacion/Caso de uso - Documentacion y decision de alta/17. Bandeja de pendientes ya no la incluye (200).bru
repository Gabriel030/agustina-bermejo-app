meta {
  name: 17. Bandeja de pendientes ya no la incluye (200)
  type: http
  seq: 17
}

get {
  url: {{baseUrl}}/program-enrollment-applications
  auth: none
}

headers {
  Authorization: Bearer {{preceptorAccessTokenDocAlta}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("ya no aparece entre las pendientes", function () {
    const propia = res.getBody().find(a => a.id === bru.getVar("applicationIdDocAlta"));
    expect(propia).to.be.undefined;
  });
}
