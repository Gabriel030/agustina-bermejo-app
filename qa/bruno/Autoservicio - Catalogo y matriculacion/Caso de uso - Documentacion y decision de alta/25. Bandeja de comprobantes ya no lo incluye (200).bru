meta {
  name: 25. Bandeja de comprobantes ya no lo incluye (200)
  type: http
  seq: 25
}

get {
  url: {{baseUrl}}/payment-receipts
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenDocAlta}}
}

docs {
  B-p2-21: rechazar la solicitud rechaza su comprobante y anula la factura de matrícula, así administración no puede cobrar una matrícula de una solicitud rechazada.
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("el comprobante de la solicitud rechazada ya no está pendiente", function () {
    const sigue = res.getBody().filter(r => r.id === bru.getVar("receiptIdDocAlta"));
    expect(sigue).to.have.lengthOf(0);
  });
}
