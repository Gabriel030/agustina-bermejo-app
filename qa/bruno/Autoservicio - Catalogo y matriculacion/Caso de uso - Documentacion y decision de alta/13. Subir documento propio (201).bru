meta {
  name: 13. Subir documento propio (201)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/me/program-enrollment-applications/{{applicationIdDocAlta}}/documents?type=DNI
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenDocAlta}}
}

body:multipart-form {
  file: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
