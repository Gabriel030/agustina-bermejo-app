meta {
  name: 9. Solicitar alta (setup, 201)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/me/program-enrollment-applications
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenDocAlta}}
}

body:multipart-form {
  programId: {{programIdDocAlta}}
  cohortId: {{cohortIdDocAlta}}
  comprobante: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("applicationIdDocAlta", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
