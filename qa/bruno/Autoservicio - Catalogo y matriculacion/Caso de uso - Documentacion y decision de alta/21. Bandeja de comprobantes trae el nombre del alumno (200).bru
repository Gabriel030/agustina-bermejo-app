meta {
  name: 21. Bandeja de comprobantes trae el nombre del alumno (200)
  type: http
  seq: 21
}

get {
  url: {{baseUrl}}/payment-receipts
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenDocAlta}}
}

docs {
  B-p5-9 / B-p2-22: el comprobante de una solicitud de alta todavía no tiene matriculación, pero la bandeja igual tiene que decir de quién es (se resuelve por quien lo subió).
}

script:post-response {
  const propios = res.getBody().filter(r => r.studentName === "QA DocumentosAlta");
  if (propios.length > 0) {
    bru.setVar("receiptIdDocAlta", Math.max(...propios.map(r => r.id)));
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("el comprobante pendiente de la solicitud trae el nombre del alumno", function () {
    expect(bru.getVar("receiptIdDocAlta")).to.not.be.undefined;
  });
}
