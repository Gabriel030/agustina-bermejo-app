meta {
  name: 6. Solicitar alta (setup, 201)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/me/program-enrollment-applications
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenDocAlta}}
}

body:json {
  {
    "programId": {{programIdDocAlta}}
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("applicationIdDocAlta", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
