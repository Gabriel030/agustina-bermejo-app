meta {
  name: 23. Alumno no puede abrir comprobantes de la bandeja (403)
  type: http
  seq: 23
}

get {
  url: {{baseUrl}}/payment-receipts/{{receiptIdDocAlta}}/file
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenDocAlta}}
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
