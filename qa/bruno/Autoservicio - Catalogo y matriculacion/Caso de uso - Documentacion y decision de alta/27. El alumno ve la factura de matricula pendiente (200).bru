meta {
  name: 27. El alumno ve la factura de matricula pendiente (200)
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/me/program-enrollment-applications
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenDocAlta}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("la solicitud aprobada trae la factura de matrícula PENDING", function () {
    const propia = res.getBody().find(a => a.id === bru.getVar("applicationIdDocAlta2"));
    expect(propia.admissionInvoice.paymentStatus).to.equal("PENDING");
  });
}
