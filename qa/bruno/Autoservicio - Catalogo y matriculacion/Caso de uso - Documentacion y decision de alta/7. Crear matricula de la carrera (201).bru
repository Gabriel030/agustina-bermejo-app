}

body:json {
  {
    "programId": {{programIdDocAlta}},
    "concept": "MATRICULA",
    "amount": 50000,
    "vigenteDesde": "2020-01-01"
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
