meta {
  name: 12. Subir documento sin sesion (403)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/me/program-enrollment-applications/{{applicationIdDocAlta}}/documents?type=DNI
  body: multipartForm
  auth: none
}

body:multipart-form {
  file: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
