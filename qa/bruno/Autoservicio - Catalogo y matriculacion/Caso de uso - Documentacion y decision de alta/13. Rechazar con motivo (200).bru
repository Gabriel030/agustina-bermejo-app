meta {
  name: 13. Rechazar con motivo (200)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/program-enrollment-applications/{{applicationIdDocAlta}}/reject
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{preceptorAccessTokenDocAlta}}
}

body:json {
  {
    "reason": "Documentación ilegible"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status REJECTED", function () {
    expect(res.getBody().status).to.equal("REJECTED");
  });
}
