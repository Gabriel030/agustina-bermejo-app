meta {
  name: 3. Registrar alumno nuevo (setup, 201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("emailAlumnoQA", "qa.solicitaralta." + Date.now() + "@example.com");
}

body:json {
  {
    "nombre": "QA",
    "apellido": "SolicitaCarrera",
    "email": "{{emailAlumnoQA}}",
    "username": "{{emailAlumnoQA}}",
    "password": "Test1234",
    "institutionId": {{institutionId}}
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("alumnoAccessToken", res.getBody().accessToken);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
