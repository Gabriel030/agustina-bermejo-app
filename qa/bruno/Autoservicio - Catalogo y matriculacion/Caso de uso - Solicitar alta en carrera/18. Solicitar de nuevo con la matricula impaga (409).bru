meta {
  name: 18. Solicitar de nuevo con la matricula impaga (409)
  type: http
  seq: 18
}

post {
  url: {{baseUrl}}/me/program-enrollment-applications?programId={{programIdQA}}&cohortId={{cohortIdQA}}
  body: none
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

tests {
  test("status 409", function () {
    expect(res.getStatus()).to.equal(409);
  });
  test("código ADMISSION_FEE_AWAITING_PAYMENT", function () {
    expect(res.getBody().code).to.equal("ADMISSION_FEE_AWAITING_PAYMENT");
  });
}

docs {
  Una solicitud aprobada con la matrícula de ingreso impaga bloquea una solicitud nueva a la misma carrera.
}
