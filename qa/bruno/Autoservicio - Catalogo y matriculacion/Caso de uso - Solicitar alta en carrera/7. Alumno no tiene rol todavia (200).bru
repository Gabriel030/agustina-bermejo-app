meta {
  name: 7. Alumno no tiene rol todavia (200)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/me
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("roles vacío — solicitar alta por sí solo no otorga nada", function () {
    expect(res.getBody().roles).to.be.an("array").that.is.empty;
  });
}
