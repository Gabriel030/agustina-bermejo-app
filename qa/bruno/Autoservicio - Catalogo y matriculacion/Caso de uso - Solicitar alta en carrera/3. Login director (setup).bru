meta {
  name: 3. Login director (setup)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "director.demo",
    "password": "Test1234"
  }
}

script:post-response {
  bru.setVar("directorAccessTokenQA", res.getBody().accessToken);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
