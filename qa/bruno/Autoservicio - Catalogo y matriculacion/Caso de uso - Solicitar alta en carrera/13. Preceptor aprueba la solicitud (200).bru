meta {
  name: 13. Preceptor aprueba la solicitud (200)
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/program-enrollment-applications/{{applicationIdQA}}/approve
  auth: none
}

headers {
  Authorization: Bearer {{preceptorAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status pasa a APPROVED", function () {
    expect(res.getBody().status).to.equal("APPROVED");
  });
}

docs {
  Épica 7 Fase 3: aprobar la solicitud aprueba también el PaymentReceipt
  asociado y crea el Payment real, en la misma transacción — ver
  `ProgramEnrollmentApplicationService.aprobar`.
}
