meta {
  name: 6. Solicitar alta - happy path (201)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/me/program-enrollment-applications
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

body:multipart-form {
  programId: {{programIdQA}}
  comprobante: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("applicationIdQA", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("status inicial es PENDING", function () {
    expect(res.getBody().status).to.equal("PENDING");
  });
}

docs {
  Épica 7 Fase 3: multipart — el comprobante de la matrícula viaja en la
  misma request que la solicitud (paso bloqueante, ver spec técnica), ya
  no es un POST JSON solo con `programId`.

  Que solicitar NO otorga rol todavía (criterio explícito de la spec: sin
  aprobación, sin rol) se verifica en el siguiente request
  (`7. Alumno no tiene rol todavia`), no acá — para no duplicar la
  llamada a `GET /me`.
}
