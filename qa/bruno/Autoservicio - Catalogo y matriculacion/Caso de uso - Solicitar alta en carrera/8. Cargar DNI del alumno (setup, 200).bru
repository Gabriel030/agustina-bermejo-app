meta {
  name: 8. Cargar DNI del alumno (setup, 200)
  type: http
  seq: 8
}

put {
  url: {{baseUrl}}/me
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

body:json {
  {
    "dni": "30112233"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
