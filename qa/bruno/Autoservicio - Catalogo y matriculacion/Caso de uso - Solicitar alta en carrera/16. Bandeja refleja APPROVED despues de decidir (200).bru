meta {
  name: 16. Bandeja refleja APPROVED despues de decidir (200)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/me/program-enrollment-applications
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("la misma solicitud ahora aparece APPROVED — no un objeto nuevo, el mismo id", function () {
    const propia = res.getBody().find((s) => s.id === bru.getVar("applicationIdQA"));
    expect(propia).to.exist;
    expect(propia.status).to.equal("APPROVED");
  });
}
