meta {
  name: 10. Administracion aprueba el comprobante (200)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/payment-receipts/{{receiptIdCursoQA}}/approve
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("status APPROVED", function () {
    expect(res.getBody().status).to.equal("APPROVED");
  });
}

docs {
  Épica 7 Fase 3: aprobar el comprobante de la primera cuota de un curso
  dispara la matriculación real (`CourseEnrollmentService.matricularComoAutoservicio`)
  en la misma transacción — ver `PaymentReceiptService.aprobar`.
}
