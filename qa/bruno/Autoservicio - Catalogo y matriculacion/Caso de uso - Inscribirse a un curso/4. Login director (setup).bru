meta {
  name: 4. Login director (setup)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "director.demo",
    "password": "Test1234"
  }
}

script:post-response {
  bru.setVar("directorAccessTokenCursoQA", res.getBody().accessToken);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Setup: Épica 7 Fase 3 exige un FeeSchedule (CUOTA_MENSUAL) vigente para
  el curso antes de poder inscribirse — solo el Director puede crearlo.
