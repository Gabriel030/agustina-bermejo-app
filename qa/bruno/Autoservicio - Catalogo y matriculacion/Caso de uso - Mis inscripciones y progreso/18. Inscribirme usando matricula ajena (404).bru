}

body:json {
  {
    "programEnrollmentId": {{otraMatriculaIdMisInsc}},
    "sectionId": {{sectionBIdMisInsc}}
  }
}

tests {
  test("status 404 — ownership, no 403", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
