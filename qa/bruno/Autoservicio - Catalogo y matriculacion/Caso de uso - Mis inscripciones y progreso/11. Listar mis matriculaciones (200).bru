meta {
  name: 11. Listar mis matriculaciones (200)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/me/program-enrollments
  auth: none
}

headers {
  Authorization: Bearer {{alumnoAccessTokenMisInsc}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("incluye la matriculación creada por staff", function () {
    const ids = res.getBody().map(e => e.id);
    expect(ids).to.include(bru.getVar("programEnrollmentIdMisInsc"));
  });
}
