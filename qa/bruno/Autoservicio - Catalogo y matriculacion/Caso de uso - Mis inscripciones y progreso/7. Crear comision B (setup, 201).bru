meta {
  name: 7. Crear comision B (setup, 201)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/subjects/{{subjectIdMisInsc}}/sections
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenMisInsc}}
}

body:json {
  {
    "name": "Comisión B",
    "termId": {{termIdMisInsc}},
    "capacity": 20
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("sectionBIdMisInsc", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
