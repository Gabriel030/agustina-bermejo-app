meta {
  name: Refresh - happy path (200)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/auth/refresh
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{preceptorRefreshToken}}"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("body trae un accessToken nuevo", function () {
    expect(res.getBody()).to.have.property("accessToken").that.is.a("string").and.not.empty;
  });
}

docs {
  # Refresh — happy path

  **Depende de** `Login - happy path (200).bru` habiendo corrido antes en
  la misma ejecución (usa `{{preceptorRefreshToken}}`, seteado ahí) —
  correr `bru run Auth -r`, no este archivo aislado.
}
