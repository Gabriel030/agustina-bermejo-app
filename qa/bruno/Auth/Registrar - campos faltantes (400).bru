meta {
  name: Registrar - campos faltantes (400)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "nombre": "",
    "email": "no-es-un-email"
  }
}

tests {
  test("status 400 — @NotBlank en apellido/username/password + @Email en email", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # Registrar — campos faltantes + email con formato inválido

  Combina dos violaciones en un solo request: campos ausentes
  (`apellido`, `username`, `password`, `institutionId`) y un `email` que
  no matchea `@Email`. Un solo `400` alcanza — no hace falta un request
  por cada campo individual, este caso ya prueba que `@Valid` está activo
  en el controller.
}
