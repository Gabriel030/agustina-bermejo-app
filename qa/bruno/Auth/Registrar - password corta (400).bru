meta {
  name: Registrar - password corta (400)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("emailUnico", "qa.pwdcorta." + Date.now() + "@example.com");
}

body:json {
  {
    "nombre": "QA",
    "apellido": "PasswordCorta",
    "email": "{{emailUnico}}",
    "username": "{{emailUnico}}",
    "password": "Ab1",
    "institutionId": {{institutionId}}
  }
}

tests {
  test("status 400 — menor a auth.password.min-length", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # Registrar — contraseña corta

  `auth.password.min-length=8` — 3 caracteres, aunque tenga letra y
  dígito, tiene que rechazarse.
}
