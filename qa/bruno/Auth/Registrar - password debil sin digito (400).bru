meta {
  name: Registrar - password debil sin digito (400)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/auth/register
  body: json
  auth: none
}

script:pre-request {
  bru.setVar("emailUnico", "qa.pwddebil." + Date.now() + "@example.com");
}

body:json {
  {
    "nombre": "QA",
    "apellido": "PasswordDebil",
    "email": "{{emailUnico}}",
    "username": "{{emailUnico}}",
    "password": "soloLetras",
    "institutionId": {{institutionId}}
  }
}

tests {
  test("status 400 — RF-AUTH-05 exige letra Y dígito", function () {
    expect(res.getStatus()).to.equal(400);
  });
}

docs {
  # Registrar — contraseña sin dígito

  `auth.password.require-letter-and-digit=true` — una contraseña de solo
  letras, aunque tenga 8+ caracteres, tiene que rechazarse.
}
