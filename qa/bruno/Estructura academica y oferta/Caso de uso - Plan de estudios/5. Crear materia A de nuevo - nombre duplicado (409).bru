meta {
  name: 5. Crear materia A de nuevo - nombre duplicado (409)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/subjects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "name": "{{nombreMateriaA}}"
  }
}

tests {
  test("status 409 — SubjectAlreadyExistsException", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
