}

body:json {
  {
    "prerequisiteProgramSubjectId": {{programSubjectAId}},
    "requirementType": "APPROVED"
  }
}

tests {
  test("status 400 — CircularPrerequisiteException, A ya requiere B", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
