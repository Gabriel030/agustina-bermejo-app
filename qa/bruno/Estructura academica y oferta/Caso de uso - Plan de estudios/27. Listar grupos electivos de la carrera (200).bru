meta {
  name: 27. Listar grupos electivos de la carrera (200)
  type: http
  seq: 27
}

get {
  url: {{baseUrl}}/programs/{{programId}}/elective-groups
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("incluye el grupo asignado", function () {
    expect(res.getBody()[0].electiveGroupId).to.equal(bru.getVar("groupId"));
  });
}
