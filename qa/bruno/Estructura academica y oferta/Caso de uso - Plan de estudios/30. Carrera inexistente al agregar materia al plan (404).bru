meta {
  name: 30. Carrera inexistente al agregar materia al plan (404)
  type: http
  seq: 30
}

post {
  url: {{baseUrl}}/programs/999999/subjects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "subjectId": {{subjectAId}},
    "curricularYear": 1,
    "curricularTerm": "FIRST",
    "credits": 5
  }
}

tests {
  test("status 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
