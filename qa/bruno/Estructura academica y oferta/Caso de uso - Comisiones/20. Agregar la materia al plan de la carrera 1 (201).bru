meta {
  name: 20. Agregar la materia al plan de la carrera 1 (201)
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/programs/{{programComparte1Id}}/subjects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "subjectId": {{subjectId}},
    "curricularYear": 1,
    "curricularTerm": "FIRST",
    "credits": 5
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
