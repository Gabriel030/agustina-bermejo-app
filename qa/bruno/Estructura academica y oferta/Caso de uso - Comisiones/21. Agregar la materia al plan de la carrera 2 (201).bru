meta {
  name: 21. Agregar la materia al plan de la carrera 2 (201)
  type: http
  seq: 21
}

post {
  url: {{baseUrl}}/programs/{{programComparte2Id}}/subjects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "subjectId": {{subjectId}},
    "curricularYear": 1,
    "curricularTerm": "FIRST",
    "credits": 5
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
