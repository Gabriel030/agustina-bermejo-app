meta {
  name: 5. Documento valido (201)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/prospects/{{prospectoId}}/documents?type=DNI
  body: multipartForm
  auth: none
}

headers {
  Authorization: Bearer {{preceptorAccessToken}}
}

body:multipart-form {
  file: @file(Gestion de personas/fixtures/dni-dummy.pdf)
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
