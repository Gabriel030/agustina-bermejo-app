meta {
  name: 7. Confirmar alta (200)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/prospects/{{prospectoId}}/confirm
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{preceptorAccessToken}}
}

script:pre-request {
  bru.setVar("dniConfirmacion", "BRUNOPROSP" + Date.now());
}

body:json {
  {
    "dni": "{{dniConfirmacion}}",
    "street": "Calle Falsa",
    "city": "CABA"
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("onboardingStatus pasa a CONFIRMADO", function () {
    expect(res.getBody().onboardingStatus).to.equal("CONFIRMADO");
  });
}
