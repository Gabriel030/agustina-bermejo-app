meta {
  name: 10. Login alumno (setup)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "alumno.demo",
    "password": "Test1234"
  }
}

script:post-response {
  bru.setVar("alumnoAccessToken", res.getBody().accessToken);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}
