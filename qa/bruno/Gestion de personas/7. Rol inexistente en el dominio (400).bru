meta {
  name: 7. Rol inexistente en el dominio (400)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/staff
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

script:pre-request {
  bru.setVar("emailRolInvalido", "bruno.rolinvalido." + Date.now() + "@example.com");
  bru.setVar("dniRolInvalido", "BRUNOINV" + Date.now());
}

body:json {
  {
    "nombre": "QA",
    "apellido": "RolInvalido",
    "email": "{{emailRolInvalido}}",
    "dni": "{{dniRolInvalido}}",
    "city": "CABA",
    "role": "SUPERADMIN"
  }
}

tests {
  test("status 400 — InvalidStaffRoleException, no 403", function () {
    expect(res.getStatus()).to.equal(400);
  });
}
