meta {
  name: 6. Director intenta dar de alta un Docente (403)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/staff
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{directorAccessToken}}
}

script:pre-request {
  bru.setVar("emailDocente2", "bruno.docente2." + Date.now() + "@example.com");
  bru.setVar("dniDocente2", "BRUNODOC2" + Date.now());
}

body:json {
  {
    "nombre": "QA",
    "apellido": "Docente",
    "email": "{{emailDocente2}}",
    "dni": "{{dniDocente2}}",
    "city": "CABA",
    "role": "DOCENTE"
  }
}

tests {
  test("status 403", function () {
    expect(res.getStatus()).to.equal(403);
  });
}
