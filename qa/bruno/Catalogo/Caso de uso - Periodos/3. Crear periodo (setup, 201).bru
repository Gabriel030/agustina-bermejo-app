meta {
  name: 3. Crear periodo (setup, 201)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/terms
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenCatalogoPeriodo}}
}

script:pre-request {
  bru.setVar("descripcionPeriodoCatalogo", "QA Bruno - Periodo catálogo " + Date.now());
}

body:json {
  {
    "year": 2027,
    "description": "{{descripcionPeriodoCatalogo}}",
    "type": "ANUAL",
    "startDate": "2027-01-01T00:00:00",
    "endDate": "2027-12-31T00:00:00"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("termIdCatalogo", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("status inicial ACTIVE", function () {
    expect(res.getBody().status).to.equal("ACTIVE");
  });
}
