meta {
  name: 5. Editar curso (200)
  type: http
  seq: 5
}

put {
  url: {{baseUrl}}/courses/{{courseIdCatalogo}}
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessTokenCatalogoCurso}}
}

body:json {
  {
    "capacity": 25
  }
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("solo el campo enviado cambia", function () {
    expect(res.getBody().capacity).to.equal(25);
    expect(res.getBody().name).to.equal(bru.getVar("nombreCursoCatalogo"));
  });
}
