meta {
  name: 1. Login administrativo (setup)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

body:json {
  {
    "username": "administrativo.demo",
    "password": "Test1234"
  }
}

script:post-response {
  bru.setVar("adminAccessTokenCatalogo", res.getBody().accessToken);
}

tests {
  test("status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
}

docs {
  Setup del caso de uso — token propio (`adminAccessTokenCatalogo`) para no
  pisar `adminAccessToken` de otra carpeta si esta se corre suelta.
}
