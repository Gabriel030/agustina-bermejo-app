meta {
  name: 9. Inscribirse de nuevo al mismo curso (409)
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/students/{{studentId}}/course-enrollments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "courseId": {{courseId}}
  }
}

tests {
  test("status 409 — AlreadyEnrolledInCourseException", function () {
    expect(res.getStatus()).to.equal(409);
  });
}
