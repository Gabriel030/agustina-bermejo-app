meta {
  name: 5. Crear comision del modulo (setup, 201)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/course-subjects/{{courseSubjectId}}/sections
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "name": "Comisión única",
    "termId": {{termId}},
    "capacity": 20
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("sectionId", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
