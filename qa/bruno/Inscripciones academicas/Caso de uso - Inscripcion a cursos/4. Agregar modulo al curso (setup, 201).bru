meta {
  name: 4. Agregar modulo al curso (setup, 201)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/courses/{{courseId}}/subjects
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

script:pre-request {
  bru.setVar("nombreModulo", "Módulo único " + Date.now());
}

body:json {
  {
    "name": "{{nombreModulo}}"
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("courseSubjectId", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
}
