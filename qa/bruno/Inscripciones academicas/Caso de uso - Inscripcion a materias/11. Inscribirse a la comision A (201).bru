meta {
  name: 11. Inscribirse a la comision A (201)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/program-enrollments/{{programEnrollmentId}}/section-enrollments
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{adminAccessToken}}
}

body:json {
  {
    "sectionId": {{sectionAId}}
  }
}

script:post-response {
  if (res.getStatus() === 201) {
    bru.setVar("sectionEnrollmentId", res.getBody().id);
  }
}

tests {
  test("status 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("status inicial ENROLLED", function () {
    expect(res.getBody().status).to.equal("ENROLLED");
  });
}
