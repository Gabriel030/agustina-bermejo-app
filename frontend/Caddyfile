{
	admin off
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:127.0.0.1/32}
		client_ip_headers X-Forwarded-For
	}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "default-src 'self'; script-src 'self' https://accounts.google.com/gsi/client; style-src 'self' 'unsafe-inline' https://accounts.google.com/gsi/style; font-src 'self'; img-src 'self' data: blob:; connect-src 'self' https://accounts.google.com/gsi/; frame-src https://accounts.google.com/gsi/; manifest-src 'self'; worker-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		-Server
	}
}

:8081 {
	respond /healthz 200
	respond 404
}

{$SITE_ADDRESS::80} {
	import security_headers
	encode zstd gzip

	@internal_actuator {
		path /api/actuator/*
		not path /api/actuator/health /api/actuator/health/*
	}
	handle @internal_actuator {
		respond 404
	}

	handle_path /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy {$BACKEND_UPSTREAM:backend:8080} {
			transport http {
				dial_timeout 5s
				response_header_timeout 90s
			}
		}
	}

	handle_errors {
		header Cache-Control "no-store"
		respond "{err.status_code} {err.status_text}"
	}

	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /icons/* {
		root * /srv
		header Cache-Control "public, max-age=86400"
		file_server
	}

	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
