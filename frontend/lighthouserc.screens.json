{
  "ci": {
    "collect": {
      "startServerCommand": "npx vite preview --outDir dist-mock --port 4174 --strictPort",
      "startServerReadyPattern": "Local",
      "url": [
        "http://localhost:4174/alumno/inicio?role=alumno",
        "http://localhost:4174/docente/tomar-asistencia?role=docente"
      ],
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": [
          "performance",
          "pwa"
        ],
        "chromeFlags": "--headless=new --no-sandbox --disable-gpu"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*/alumno/inicio.*",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 17590,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.266,
                "aggregationMethod": "pessimistic"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 396,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 1024178,
                "aggregationMethod": "pessimistic"
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 1059638,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        },
        {
          "matchingUrlPattern": ".*/docente/tomar-asistencia.*",
          "assertions": {
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 14237,
                "aggregationMethod": "median"
              }
            ],
            "cumulative-layout-shift": [
              "error",
              {
                "maxNumericValue": 0.01,
                "aggregationMethod": "pessimistic"
              }
            ],
            "total-blocking-time": [
              "error",
              {
                "maxNumericValue": 281,
                "aggregationMethod": "median"
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 979327,
                "aggregationMethod": "pessimistic"
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 1014786,
                "aggregationMethod": "pessimistic"
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci/report"
    }
  }
}
