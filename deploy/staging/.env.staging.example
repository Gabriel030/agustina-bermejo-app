# =============================================================================
# Variables propias del entorno de ensayo (staging). Se usa JUNTO con el resto del
# inventario de deploy/.env.example: copiar ese archivo a deploy/.env.staging y completar
# también estas. deploy/.env.staging NO se sube al repo.
#
#   cp deploy/.env.example deploy/.env.staging
#   (agregar o ajustar lo de este archivo)
#   chmod 600 deploy/.env.staging
#
# Todo secreto de staging se genera de nuevo: NUNCA reutilizar los de producción.
# =============================================================================

# [OBLIGATORIA] Nombre del proyecto compose. Distinto del de producción: de ahí salen los
# nombres de los volúmenes (base, /data, Caddy) y de los contenedores, que así quedan separados.
COMPOSE_PROJECT_NAME=agustina-bermejo-staging

# [OBLIGATORIA] Archivo de variables que lee el backend.
ENV_FILE=deploy/.env.staging

# [OBLIGATORIA] Dominio del ensayo, sin esquema. Parametrizado: depende del proveedor y del
# dominio de producción (E29 A2). Sin dominio: SITE_ADDRESS=:80 y los puertos de abajo.
SITE_ADDRESS=staging.escuela.example.com
CORS_ALLOWED_ORIGINS=https://staging.escuela.example.com
FRONTEND_BASE_URL=https://staging.escuela.example.com
BACKEND_BASE_URL=https://staging.escuela.example.com/api

# [OPCIONAL] Puertos publicados. Si staging comparte servidor con producción tienen que ser
# distintos de los de producción (80/443). Detrás de otro proxy, usar puertos altos.
HTTP_PORT=8080
HTTPS_PORT=8443

# [OBLIGATORIA] Etiqueta del entorno en las métricas y los logs.
APP_ENV=staging

# [OBLIGATORIA] Secretos nuevos, distintos de producción.
POSTGRES_PASSWORD=cambiar-por-una-contrasena-larga
JWT_SECRET=cambiar-por-una-clave-aleatoria-de-48-caracteres-o-mas
# Clave propia de los enlaces de baja de comunicaciones masivas, distinta de JWT_SECRET. Staging corre con perfil prod: sin ella el backend no arranca.
BROADCAST_UNSUBSCRIBE_SECRET=cambiar-por-una-clave-aleatoria-de-48-caracteres-o-mas

# [OBLIGATORIA] Con "mock" los mails no salen de verdad: ningún usuario real recibe avisos del
# ensayo. Dejar en mock salvo que se pruebe Brevo con una casilla de prueba.
TRANSACTIONAL_MAIL_PROVIDER=mock
# Sin credenciales reales de Mercado Pago ni de Google en staging, salvo cuentas de prueba.
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
VITE_GOOGLE_CLIENT_ID=

# [OPCIONAL] Límites de recursos: los mismos que producción, para que el ensayo sea representativo.
# BACKEND_MEMORY_LIMIT=1g
# POSTGRES_MEMORY_LIMIT=1g

# --- Propias del ensayo (las lee deploy/staging/docker-compose.staging.yml)

# [OPCIONAL] Perfiles de Spring. prod = igual que producción, con base vacía.
# Con datos demo: prod,local,demo (crea además cuentas *.demo con clave conocida: no exponer
# ese staging a internet sin una barrera delante).
# STAGING_SPRING_PROFILES=prod

# [OPCIONAL] Con perfil demo, siembra la institución demo al arrancar (idempotente: si ya hay datos no repite).
# STAGING_DEMO_SEED=false

# [OPCIONAL] Modo inicial de facturación. Igual que producción (apagada) por defecto.
# STAGING_BILLING_MODE=OFF
