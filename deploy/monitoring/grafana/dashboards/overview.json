{
  "uid": "ab-overview",
  "title": "Agustina Bermejo - Resumen",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-6h", "to": "now"},
  "panels": [
    {"id": 1, "type": "stat", "title": "Backend arriba", "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "up{job=\"backend\"}"}],
     "fieldConfig": {"defaults": {"mappings": [{"type": "value", "options": {"0": {"text": "CAIDO"}, "1": {"text": "OK"}}}], "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "green", "value": 1}]}}}},
    {"id": 2, "type": "stat", "title": "Horas desde el ultimo backup", "gridPos": {"x": 6, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "(time() - backup_last_success_timestamp_seconds) / 3600"}],
     "fieldConfig": {"defaults": {"unit": "h", "decimals": 1, "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 7}, {"color": "red", "value": 13}]}}}},
    {"id": 3, "type": "stat", "title": "Disco libre del host", "gridPos": {"x": 12, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"} / node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "red", "value": null}, {"color": "orange", "value": 0.15}, {"color": "green", "value": 0.3}]}}}},
    {"id": 4, "type": "stat", "title": "Pool de conexiones en uso", "gridPos": {"x": 18, "y": 0, "w": 6, "h": 4},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "hikaricp_connections_active / hikaricp_connections_max"}],
     "fieldConfig": {"defaults": {"unit": "percentunit", "thresholds": {"mode": "absolute", "steps": [{"color": "green", "value": null}, {"color": "orange", "value": 0.7}, {"color": "red", "value": 0.9}]}}}},
    {"id": 5, "type": "timeseries", "title": "Pedidos por segundo por estado", "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"backend\"}[5m]))", "legendFormat": "{{status}}"}]},
    {"id": 6, "type": "timeseries", "title": "Latencia promedio (s)", "gridPos": {"x": 12, "y": 4, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(rate(http_server_requests_seconds_sum{job=\"backend\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"backend\"}[5m])), 0.001)", "legendFormat": "promedio"}]},
    {"id": 7, "type": "timeseries", "title": "Conexiones del pool", "gridPos": {"x": 0, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "hikaricp_connections_active", "legendFormat": "activas"}, {"refId": "B", "expr": "hikaricp_connections_max", "legendFormat": "maximo"}]},
    {"id": 8, "type": "timeseries", "title": "Memoria heap de la JVM", "gridPos": {"x": 12, "y": 12, "w": 12, "h": 8},
     "datasource": {"type": "prometheus", "uid": "prometheus"},
     "targets": [{"refId": "A", "expr": "sum(jvm_memory_used_bytes{area=\"heap\"})", "legendFormat": "usada"}]}
  ]
}
